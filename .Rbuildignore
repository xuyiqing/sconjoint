# CRAN: ship a lean test set: bundled data, the estimator end to end on synthetic fold states, the plot
# functions; about 2 seconds. Every other test file and folder stays in the repo and runs locally with
# NOT_CRAN=true TESTTHAT_PARALLEL=true TESTTHAT_CPUS=10.
^tests/testthat/(?!(helper-sc-states|test-data-bundled|test-sc-engine|test-sc-plots)\.R$)
^tests/testthat/_problems$
^tests/testthat/testthat-problems\.rds$

# Developer scripts: kept in the repo, not shipped.
^inst/examples$
^inst/extdata/make_toy_fit\.R$
