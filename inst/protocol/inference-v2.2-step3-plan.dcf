Status: prospective_calibration_plan_frozen_simulation_not_run
Design-Template-Ids: br2017,gs2020,sw2022
Design-Input-Policy: response_free_deltaX_Z_respondent_and_task_layout_only
Application-Outcomes-Permitted: false
Oracle-Calibration-Replications-Per-Cell: 2000
Oracle-Validation-Replications-Per-Cell: 2000
Numerical-Calibration-Replications-Per-Cell: 8
Numerical-Validation-Replications-Per-Cell: 8
Oracle-Calibration-Master-Seed: 100000000
Oracle-Validation-Master-Seed: 500000000
Numerical-Calibration-Master-Seed: 900000000
Numerical-Validation-Master-Seed: 1300000000
Seed-Formula: master+(design_index-1)*30000000+(regime_index-1)*2000000+replication
Maximum-Workers: 10
Nominal-Coverage: 0.95
Minimum-Benign-Calibration-Passage: 0.90
Maximum-Targeted-False-Certification: 0.05
