Settings-Id: paperps-v2.6-end-to-end-evaluator-settings-v1
Protocol-Id: paperps-inference-2026-09-07-v2.6
Plan-Id: paperps-rapid-validation-2026-09-07-v2.6-v1
Status: prospective_evaluator_settings_frozen_outcomes_locked_implementation_absent
Evaluator-Source-Prefix: calibration-v26
Evaluator-Function-Prefix: scmix_v26
Canonical-State-Directory: inst/protocol
Canonical-Run-Directory: runs/v26/rapid_validation_2026-09-07
Fit-Rank: 1
Mean-Candidates: constant,linear
Deviation-Penalty: 0.01
Adam-Epochs: 400
Adam-Learning-Rate: 0.01
Mu-Bound: 10
Kappa-Bound: 10
Alpha-Bound: 5
Loading-A-Bound: 10
Network-Weight-Bound: 10
Outer-Folds: 2
Inner-Folds: 2
Optimizer-Starts: 2
Optimizer-Start-Selection: minimize_declared_penalized_training_criterion
Reference-GH-Nodes: 15
Refined-GH-Nodes: 31
Batch-Mode: full_batch
Mean-Selection-Score: respondent_level_complete_sequence_log_score
Mean-Selection-Tie-Break: least_complex_then_registry_order
Numeric-Precision: float64
Compute-Device: cpu
Parallel-Backend: base_R_PSOCK_spawn_twelve_processes
Maximum-Workers: 12
Workers-Per-Cell: 2
Deterministic-Lanes-Per-Cell: 2
Worker-Id-Formula: 2*(cell_index-1)+lane_index
Wave-Lane-Assignment: lane_1_replication_2w_minus_1;lane_2_replication_2w
Torch-Threads-Per-Worker: 1
Polish-Method: full_batch_LBFGS_strong_wolfe
Polish-Max-Iterations: 50
Polish-History-Size: 50
Polish-Tolerance-Grad: 0.0000000001
Polish-Tolerance-Change: 0.000000000001
Polish-Learning-Rate: 1
Ridge-Primary: Ntrain^(-3/4)
Ridge-Sensitivities: Ntrain^(-1),Ntrain^(-1/2)
Ridge-Selection: none
Riesz-Numerical-Rank-Rule: dimension_times_machine_epsilon_times_leading_eigenvalue
Riesz-Heldout-Defect: honest_information_scaled
Derivative-Step: machine_epsilon^(1/3)
Derivative-Gate-Input: actual_analytic_vs_h_and_h_over_2_relative_error_v2.2_protocol_exact_flag_not_used
Integration-Branches: fixed_GH15_state_evaluated_at_GH31|GH31_LBFGS_from_exact_GH15_state_zero_Adam
Integration-Movement-Rule: maximum_over_both_GH31_branches
Near-Optimum-Objective-Gap: 0.000001
Near-Optimum-Target-Spread: 0.10
Near-Optimum-Start-Set: both_frozen_optimizer_starts_with_relative_objective_gap_at_most_0.000001
Fit-Gate-Start-Scope: selected_full_and_outer_states_for_KKT_loading_and_nested_gates;near_optimum_states_for_polish_precision_and_finiteness;discarded_far_starts_descriptive
Repolished-Gate-Scope: selected_full_and_outer_GH31_exact_state_zero_Adam_repolishes_for_KKT_loading_polish_precision_and_finiteness
Share-Boundary-Evaluation: exact_declared_tie_rule_at_zero_variance_with_no_positive_variance_floor
Share-Regularity-Gate: own_directional_variance_studentized_margin_at_least_1.96
Target-Constraint-Map-Id: paperps_v26_registered_target_constraint_map_v1
Confidence-Set-Map-Id: paperps_v26_rectangle_mapping_v1
Family-Critical-Value: type1_empirical_0.95_quantile_of_common_9999_respondent_multiplier_maximum_no_interpolation
Fit-Seed-Offset: 500000
Outer-Fold-Seed-Component: v26-outer-folds
Optimizer-Start-Seeds: deterministic_package_seed_derivation
RNG-Kind: L'Ecuyer-CMRG
RNG-Normal-Kind: Inversion
RNG-Sample-Kind: Rejection
Preliminary-Schedule: four_complete_12_job_waves_with_exactly_12_one_thread_workers_and_two_deterministic_lanes_per_cell
Wave-One-Selection: chronologically_first_integrity_valid_wave_one_only
Wave-One-Rerun-After-Valid-Wave: prohibited_regardless_of_runtime
Wave-One-Wall-Clock-Definition: monotonic_elapsed_from_before_cluster_creation_through_cluster_shutdown_and_all_artifact_and_manifest_verification
Wave-One-Runtime-Projection: 1.25_times_4_times_exact_observed_wall_time_of_the_complete_integrity_valid_12_job_12_worker_wave_one
Wave-One-Runtime-Safety-Factor: 1.25
Wave-One-Wall-Clock-Cutoff-Seconds: 3600
Wave-One-Artifact-Visibility: sealed_replication_artifacts_public_integrity_time_resource_only
Wave-One-Inspection-Firewall: no_synthetic_choice_fit_target_gate_interval_coverage_or_operating_characteristic_result_available_or_inspected_for_go_no_go
Preliminary-Reps-Per-Cell: 8
Preliminary-Waves: 4
Preliminary-Early-Success: false
Preliminary-Early-Stop: none_all_48_attempts_required_after_wave_one_runtime_pass
Preliminary-Family-Approval: prohibited
Confirmatory-Minimum-Reps-Per-Cell: 50
Confirmatory-Preferred-Reps-Per-Cell: 100
Confirmatory-Continuation: same_evaluator_and_seed_stream_unconditional_on_preliminary_results
