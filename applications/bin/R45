#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(CDPATH= cd -- "${script_dir}/../.." && pwd)
runtime_root="${project_root}/.runtime/R-4.5.3-root"
runtime_link=/tmp/R45
library_root="${project_root}/.R-library/4.5"

if [ ! -x "${runtime_root}/Library/Frameworks/R.framework/Resources/bin/R" ]; then
  echo "Local R 4.5.3 runtime is missing at ${runtime_root}." >&2
  echo "See applications/sw2022/manifests/environment.md for bootstrap details." >&2
  exit 1
fi

ln -sfn "${runtime_root}" "${runtime_link}"
mkdir -p "${library_root}"

export R_LIBS_USER="${library_root}"
export R_ENVIRON_USER=/dev/null
export R_PROFILE_USER=/dev/null
# Torch's self-check launches the framework's hard-coded Rscript path.  The
# project runtime is relocated, so verify Torch explicitly in the bootstrap
# and skip only that subprocess check during ordinary launches.
export TORCH_VERIFY_LOAD=FALSE

exec "${runtime_link}/Library/Frameworks/R.framework/Resources/bin/R" "$@"
